# Documentation for all supported env variables:
# https://immich.app/docs/install/environment-variables

# The location where uploaded files are stored (see compose bind mount)
# UPLOAD_LOCATION=./library  # (handled by compose: /usr/src/app/upload)

# Database files location (handled by compose; network shares not supported for DB)
# DB_DATA_LOCATION=./postgres

# Timezone. server-b runs at UTC-04:00. Applied to all Immich containers via env_file.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
TZ=America/New_York

# Immich version: PIN to a specific release. With "release" an unattended container recreate can
# silently pull a newer version (possibly with breaking DB migrations) against your only copy of
# these photos. You are currently on v2.7.5. Bump this deliberately, after reading the release
# notes and backing up the database.
IMMICH_VERSION=release

# Postgres connection.
# WARNING: the LIVE database password is currently 'ChangeMe' (weak). It is not network-exposed
# (internal bridge, no published port), but it's below standard. Rotating it on an EXISTING DB is a
# two-step, in-lockstep change - setting this var alone does NOT change the real DB password:
#   1) docker exec -it immich_postgres psql -U postgres -d immich -c "ALTER USER postgres WITH PASSWORD '<new>';"
#   2) set DB_PASSWORD below to the SAME value, then redeploy the stack
# Use only A-Za-z0-9 (no special characters or spaces).
DB_PASSWORD=ChangeME
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
