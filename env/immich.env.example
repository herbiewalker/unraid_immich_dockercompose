# Documentation for all supported env variables:
# https://immich.app/docs/install/environment-variables

# The location where uploaded files are stored (see compose bind mount)
# UPLOAD_LOCATION=./library  # (handled by compose: /usr/src/app/upload)

# Database files location (handled by compose; network shares not supported for DB)
# DB_DATA_LOCATION=./postgres

# Timezone. Applied to all Immich containers via env_file. Set to your own TZ.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
TZ=Etc/UTC

# Immich version. PIN to a specific release — never "release" or an unversioned
# tag, since an unattended container recreate could silently pull a newer
# version with breaking DB migrations against your only copy of these photos.
# Bump deliberately, after reading release notes + a fresh DB + files backup.
#
# Version history on this stack:
#   v2.7.5   deployed baseline (PG18 + VectorChord 0.5.3 already migrated)
#   v3.1.0   bumped 2026-09-05; added IMMICH_MEDIA_LOCATION shim (see below)
IMMICH_VERSION=v3.1.0

# ---------------------------------------------------------------------------
# IMMICH_MEDIA_LOCATION — v3 compatibility shim (added 2026-09-05, v2.7.5→v3.1.0)
# ---------------------------------------------------------------------------
# Tells the Immich app WHICH DIRECTORY INSIDE THE CONTAINER holds media
# (photos, thumbnails, encoded videos, uploads). It doesn't move any files
# and it doesn't touch the host disk — it only points the running app at
# the mount point the compose file already binds.
#
# Why we set it:
#   Immich v3 changed the in-container default from `/usr/src/app/upload`
#   (legacy) to `/data` (new). Our compose still binds photos to the legacy
#   path (`- immich-photos:/usr/src/app/upload`). Without this override, v3
#   would look at `/data` (an empty anonymous volume in our stack), see no
#   library, and behave as if it were a fresh install.
#
# The full chain:
#   Host disk:            /mnt/user/immich/immich/photos       (zpool bind)
#     |  compose volume `immich-photos` (driver_opts: type=none, bind)
#     v
#   In container mount:   /usr/src/app/upload                  (our compose)
#     |  IMMICH_MEDIA_LOCATION tells the app to read/write HERE
#     v
#   Immich app reads:     /usr/src/app/upload                  (this env var)
#
# The proper long-term fix is to migrate the compose mount from
# `/usr/src/app/upload` to `/data` and drop this env var — matching upstream.
# Deferred: doing both at once mixes two changes in one upgrade. Leave the
# shim in place; migrate the mount path in a separate, standalone change.
# ---------------------------------------------------------------------------
IMMICH_MEDIA_LOCATION=/usr/src/app/upload

# Postgres connection.
# Set DB_PASSWORD to a strong, unique value before first deploy. Use only A-Za-z0-9
# (no special characters or spaces).
#
# NOTE: on an EXISTING database, changing this var alone does NOT change the real DB
# password — it's a two-step, in-lockstep change:
#   1) docker exec -it immich_postgres psql -U postgres -d immich -c "ALTER USER postgres WITH PASSWORD '<new>';"
#   2) set DB_PASSWORD below to the SAME value, then redeploy the stack
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
